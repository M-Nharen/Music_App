{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/M-Nharen/Music_App/analyzer/schema/lyrics.schema.json",
  "title": "Qwertone lyrics (format version 1, lyrics_version 2)",
  "description": "lyrics.json written next to song.json by qwertone-analyze. See SONG_FORMAT.md.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "analyzer",
    "song",
    "status",
    "language",
    "has_word_timing",
    "offset",
    "sources",
    "lines"
  ],
  "properties": {
    "format": {
      "const": "qwertone-lyrics"
    },
    "format_version": {
      "const": 1
    },
    "analyzer": {
      "type": "object",
      "required": [
        "version",
        "created",
        "fingerprint"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "lyrics_version": {
          "type": "integer"
        },
        "created": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "models": {
          "type": "boolean",
          "description": "models (Whisper, translator) were allowed (not --light)"
        },
        "incomplete": {
          "type": "boolean",
          "description": "a model step failed (e.g. weights missing offline); the next run retries"
        }
      }
    },
    "song": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "album",
        "duration",
        "sha256"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "artist": {
          "type": [
            "string",
            "null"
          ]
        },
        "album": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "number",
            "null"
          ]
        },
        "sha256": {
          "type": "string"
        },
        "identified_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "const": "acoustid"
                },
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "artist": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "album": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "recording_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fetched": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "status": {
      "enum": [
        "synced",
        "plain",
        "instrumental",
        "not_found"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "Song language, BCP 47: ta, te, hi, kn, ml, en ..., <lang>-Latn for romanised (ta-Latn Tanglish, hi-Latn Hinglish, te-Latn Tenglish), und"
    },
    "has_word_timing": {
      "type": "boolean"
    },
    "offset": {
      "type": "number"
    },
    "sources": {
      "type": "object",
      "required": [
        "words",
        "timing",
        "translation",
        "transliteration"
      ],
      "properties": {
        "words": {
          "$ref": "#/$defs/sourceOrNull"
        },
        "timing": {
          "$ref": "#/$defs/sourceOrNull"
        },
        "translation": {
          "$ref": "#/$defs/sourceOrNull"
        },
        "transliteration": {
          "$ref": "#/$defs/sourceOrNull"
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "every line language in the song, most lines first"
    },
    "language_source": {
      "enum": [
        "user",
        "whisper",
        "text",
        "tag",
        "none"
      ]
    },
    "auto_generated": {
      "type": "object",
      "required": [
        "words",
        "timing",
        "translation"
      ],
      "properties": {
        "words": {
          "type": "boolean"
        },
        "timing": {
          "type": "boolean"
        },
        "translation": {
          "type": "boolean"
        }
      }
    },
    "whisper": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "detected": {
          "type": [
            "string",
            "null"
          ]
        },
        "language_probability": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_languages": {
          "type": "array"
        },
        "per_window_language": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "synced"
          }
        }
      },
      "then": {
        "properties": {
          "lines": {
            "items": {
              "properties": {
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "instrumental",
              "not_found"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "lines": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "url",
        "file",
        "fetched"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "embedded",
            "lrclib",
            "generated",
            "user",
            "whisper",
            "aligner",
            "translator"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "fetched": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "auto_generated": {
          "type": "boolean"
        },
        "machine_translation": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        },
        "library": {
          "type": "string"
        },
        "matched": {
          "type": "number"
        }
      }
    },
    "sourceOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/source"
        }
      ]
    },
    "time": {
      "type": [
        "number",
        "null"
      ]
    },
    "word": {
      "type": "object",
      "required": [
        "text",
        "start",
        "end",
        "start_beat",
        "end_beat"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "start_beat": {
          "type": [
            "number",
            "null"
          ]
        },
        "end_beat": {
          "type": [
            "number",
            "null"
          ]
        },
        "tanglish": {
          "type": [
            "string",
            "null"
          ],
          "description": "deprecated: = romanized on Tamil lines, else null"
        },
        "romanized": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "start",
        "end",
        "start_beat",
        "end_beat",
        "text",
        "language",
        "tanglish",
        "translation",
        "words"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "start_beat": {
          "$ref": "#/$defs/time"
        },
        "end_beat": {
          "$ref": "#/$defs/time"
        },
        "text": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "tanglish": {
          "type": [
            "string",
            "null"
          ],
          "description": "deprecated (10a-lite): = romanized on Tamil lines, else null"
        },
        "translation": {
          "type": [
            "string",
            "null"
          ],
          "description": "English machine translation; null for English and romanised lines"
        },
        "words": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/word"
              }
            }
          ]
        },
        "sources": {
          "type": "object",
          "description": "Per-line overrides of the top-level sources (e.g. a user edit). Missing keys = top level.",
          "properties": {
            "words": {
              "$ref": "#/$defs/sourceOrNull"
            },
            "timing": {
              "$ref": "#/$defs/sourceOrNull"
            },
            "translation": {
              "$ref": "#/$defs/sourceOrNull"
            },
            "transliteration": {
              "$ref": "#/$defs/sourceOrNull"
            }
          }
        },
        "romanized": {
          "type": [
            "string",
            "null"
          ],
          "description": "Latin letters for Indic-script text; = text for <lang>-Latn lines; else null"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "only for auto-generated words/timing"
        }
      }
    }
  }
}
